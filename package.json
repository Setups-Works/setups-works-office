{
  "name": "@setupsworks/office",
  "productName": "Setups Works Office",
  "version": "0.9.1",
  "description": "Run a team of AI coding agents (Claude Code, Codex) on your repo in Docker Sandboxes, and watch them work in a pixel-art office.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Setups-Works/setups-works-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Setups-Works/setups-works-office.git"
  },
  "bugs": {
    "url": "https://github.com/Setups-Works/setups-works-office/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "coding-agents",
    "claude",
    "claude-code",
    "codex",
    "docker-sandboxes",
    "mcp",
    "pixel-art",
    "developer-tools"
  ],
  "bin": {
    "setups-works-office": "bin/setups-works-office.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "dist-server",
    "scripts/fix-node-pty.mjs",
    "docs/images",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:hq": "concurrently -k -n hq,ui -c magenta,cyan \"tsx watch server/main.ts --dev\" \"vite\"",
    "hq": "vite build --logLevel warn && tsx server/main.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server && tsc --noEmit -p desktop",
    "build": "tsc --noEmit -p . && tsc --noEmit -p server && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "prepack": "npm run build",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "landing:dev": "vite --config landing-page/vite.config.ts",
    "landing:build": "tsc --noEmit -p landing-page && vite build --config landing-page/vite.config.ts",
    "landing:preview": "vite preview --config landing-page/vite.config.ts",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron desktop-dist/main.cjs",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/headless": "5.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.1",
    "pixi.js": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "zustand": "^5.0.15"
  },
  "author": "Setups Works"
}
